%% ------------------------------------------------------------------------------
%% DIAGRAM 4: SATELLITE DATA PROCESSING FLOWCHART
%% ------------------------------------------------------------------------------
flowchart TD
    Start(["Start Satellite Ingestion"]) --> ReadNC["Read INSAT-3DS NetCDF-4 Archive"]
    ReadNC --> ExtractMeta["Extract Coordinates & Metadata<br/>(Lat: 12.97°N, Lon: 77.59°E)"]
    ExtractMeta --> CropROI["Sub-grid Crop to Bengaluru ROI<br/>(162 x 159 Grid Cells)"]
    CropROI --> CheckNaN{"Valid Radiance /<br/>Pixel Mask?"}
    CheckNaN -- "No" --> Impute["Impute Missing Pixels / Spatial Filter"]
    CheckNaN -- "Yes" --> Binarize["Otsu Adaptive Binary Thresholding"]
    Impute --> Binarize
    Binarize --> MorphClean["Morphological Opening & Closing (3x3)"]
    MorphClean --> SaveNPZ["Cache Standardized NPZ Array"]
    SaveNPZ --> End(["Forward to Motion Tracking Engine"])

%% ------------------------------------------------------------------------------
%% DIAGRAM 5: RAINFALL PREDICTION WORKFLOW
%% ------------------------------------------------------------------------------
flowchart TD
    WIn(["Meteorological Stream Ingestion"]) --> Align["Temporal Synchronization & Feature Scaling"]
    Align --> Feat25["Formulate 25 Synoptic Parameters<br/>(Temp, Dew, Humidity, Pressure, Wind, etc.)"]
    Feat25 --> Stage1["Stage 1: XGBoost Classification Model"]
    Stage1 --> PredictClass{"P(Rain) >= 0.50 Threshold?"}
    PredictClass -- "No (Dry Conditions)" --> OutputNoRain["Status: NO RAIN<br/>Precipitation Volume = 0.00 mm"]
    PredictClass -- "Yes (Wet Event)" --> Stage2["Stage 2: XGBoost Regression Model"]
    Stage2 --> RegressVal["Estimate Continuous Rainfall (mm)"]
    RegressVal --> OutputRain["Status: RAIN DETECTED<br/>Precipitation Volume: Q mm"]
    OutputNoRain --> DashboardPush(["Update Dashboard Metrics"])
    OutputRain --> DashboardPush

%% ------------------------------------------------------------------------------
%% DIAGRAM 6: CLOUD DETECTION AND TRACKING WORKFLOW
%% ------------------------------------------------------------------------------
flowchart TD
    Inp(["Binarized Satellite Frame t"]) --> CCA["Connected Component Analysis (8-Connectivity)"]
    CCA --> AreaFilt{"Region Area >= Minimum Pixel Area?"}
    AreaFilt -- "No" --> Discard["Discard Transient Noise"]
    AreaFilt -- "Yes" --> ExtractProps["Extract Centroid, Area, Bounding Box"]
    ExtractProps --> LoadPrev["Retrieve Active Cloud Objects at t-1"]
    LoadPrev --> BuildCost["Construct Pairwise Euclidean Distance Matrix C"]
    BuildCost --> GateMax{"Distance <= Max Motion Threshold?"}
    GateMax -- "No" --> InfCost["Assign Infinite Cost (Block Assignment)"]
    GateMax -- "Yes" --> RetainCost["Retain Euclidean Metric"]
    InfCost --> SolveHung["Solve Global Munkres / Hungarian Algorithm"]
    RetainCost --> SolveHung
    SolveHung --> UpdateTracks["Update Existing Cloud Kinematics & Trajectory"]
    SolveHung --> CreateNew["Initialize New Cloud Tracks for Unmatched"]
    UpdateTracks --> SaveTracks(["Export Trajectory GeoJSON"])
    CreateNew --> SaveTracks

%% ------------------------------------------------------------------------------
%% DIAGRAM 7: HUNGARIAN ASSIGNMENT ALGORITHM WORKFLOW
%% ------------------------------------------------------------------------------
flowchart TD
    StartH(["Begin Hungarian Tracking Step"]) --> InitMat["Construct Cost Matrix C [N x M]<br/>C_ij = Euclidean Distance(c_i^(t-1), c_j^(t))"]
    InitMat --> Step1["Step 1: Row Reduction<br/>Subtract Row Minimums"]
    Step1 --> Step2["Step 2: Column Reduction<br/>Subtract Column Minimums"]
    Step2 --> Step3["Step 3: Cover All Zeros with Minimum Lines (k)"]
    Step3 --> TestOpt{"k == Dimension?"}
    TestOpt -- "No" --> Step4["Step 4: Shift Smallest Uncovered Element<br/>Adjust Matrix & Return to Step 3"]
    Step4 --> Step3
    TestOpt -- "Yes" --> AssignOpt["Extract Global Optimal Pairing (i*, j*)"]
    AssignOpt --> VelocityComp["Calculate Instantaneous Velocity (vx, vy) & Speed"]
    VelocityComp --> TermH(["Store State Vector"])

